  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs",
    "start": "node scripts/run.mjs --production",
    "build": "tsc -b && vite build",
    "preview": "node scripts/run.mjs --production",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
