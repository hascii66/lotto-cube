{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "th-TH",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "Toast",
    "CRUD"
  ],
  "ownership": { "Select/Listbox": "native", "Date": "native" },
  "requiredCommands": ["typecheck", "unit", "e2e", "build", "format"],
  "commands": {
    "typecheck": "npm run typecheck",
    "unit": "npm test",
    "e2e": "npm run test:e2e",
    "build": "npm run build",
    "format": "npm run format:check"
  },
  "evidence": {
    "crudFullFlow": "tests/app.spec.ts",
    "failurePaths": "tests/app.spec.ts"
  }
}
